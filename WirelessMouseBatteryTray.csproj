<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.3.0</Version>
    <InformationalVersion>1.3.0</InformationalVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WirelessMouseBatteryTray</AssemblyName>
    <Product>Wireless Mouse Battery Tray</Product>
    <RootNamespace>WirelessMouseBatteryTray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Include="devices.json" LogicalName="WirelessMouseBatteryTray.devices.json" />
  </ItemGroup>
</Project>
